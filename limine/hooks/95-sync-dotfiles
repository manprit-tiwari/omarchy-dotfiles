#!/usr/bin/env bash
# Signals the user-level limine-sync.path unit to sync /boot/limine.conf to dotfiles.
# This hook runs inside limine-snapper-watcher.service which has ProtectHome=yes and
# drops CAP_SETUID/CAP_SETGID, so direct git operations and runuser are impossible here.
# We write a trigger to /tmp (the only allowed writable path) and let the user service
# handle the actual copy + git commit.
touch /tmp/limine-sync-needed
