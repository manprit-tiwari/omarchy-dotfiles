[Unit]
Description=Second-brain gardener (Claude Code sessions -> ~/second-brain notes)

[Service]
Type=oneshot
Environment=PATH=%h/.local/share/mise/shims:%h/.local/share/mise/installs/claude/latest:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/second-brain/tools/gardener/gardener.py --if-due
TimeoutStartSec=3h
